# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Testing & coverage
.coverage
.coverage.*
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/

# Jupyter
.ipynb_checkpoints/
*.ipynb_meta

# Package outputs — do not commit generated artefacts
data/output/*
!data/output/.gitkeep
logs/*
!logs/.gitkeep

# Input data — do not commit other people's filings
data/input/pdf/*
!data/input/pdf/.gitkeep
data/input/xbrl/*
!data/input/xbrl/.gitkeep
